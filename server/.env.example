# העתק לקובץ .env ומלא ערכים אמיתיים
PORT=8080
# מחרוזת חיבור PostgreSQL
DATABASE_URL=postgres://kdroid:password@localhost:5432/kdroid
# סוד לחתימת JWT — החלף למחרוזת אקראית ארוכה
JWT_SECRET=change-me-to-a-long-random-string
# מנהל ראשוני (נוצר בהרצת init-db אם אינו קיים)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password
# מוצא CORS מותר (כתובת האתר). * לפיתוח בלבד.
CORS_ORIGIN=*
